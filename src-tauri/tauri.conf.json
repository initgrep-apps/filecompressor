{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "file-compressor",
  "version": "0.1.0",
  "identifier": "com.filecompressor.app",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "File Size Optimizer",
        "width": 900,
        "height": 640,
        "minWidth": 760,
        "minHeight": 500,
        "decorations": true,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
      "resources": {
        "gs-resources/": "gs-resources/"
      },
      "externalBin": [
        "binaries/vips",
        "binaries/qpdf",
        "binaries/gs",
        "binaries/ffmpeg",
        "binaries/ffprobe"
      ],
      "macOS": {
        "signingIdentity": "-",
        "frameworks": [
          "frameworks/libIex-3_5.34.dylib",
          "frameworks/libIlmThread-3_5.34.dylib",
          "frameworks/libImath-3_2.30.dylib",
          "frameworks/libOpenEXR-3_5.34.dylib",
          "frameworks/libOpenEXRCore-3_5.34.dylib",
          "frameworks/libX11.6.dylib",
          "frameworks/libXau.6.dylib",
          "frameworks/libXdmcp.6.dylib",
          "frameworks/libXext.6.dylib",
          "frameworks/libXrender.1.dylib",
          "frameworks/libaec.0.dylib",
          "frameworks/libarchive.13.dylib",
          "frameworks/libb2.1.dylib",
          "frameworks/libbrotlicommon.1.dylib",
          "frameworks/libbrotlidec.1.dylib",
          "frameworks/libcairo-gobject.2.dylib",
          "frameworks/libcairo.2.dylib",
          "frameworks/libcfitsio.10.dylib",
          "frameworks/libcgif.0.dylib",
          "frameworks/libdatrie.1.dylib",
          "frameworks/libdeflate.0.dylib",
          "frameworks/libexif.12.dylib",
          "frameworks/libfftw3.3.dylib",
          "frameworks/libfontconfig.1.dylib",
          "frameworks/libfreetype.6.dylib",
          "frameworks/libfribidi.0.dylib",
          "frameworks/libgdk_pixbuf-2.0.0.dylib",
          "frameworks/libgif.dylib",
          "frameworks/libgio-2.0.0.dylib",
          "frameworks/libglib-2.0.0.dylib",
          "frameworks/libgmodule-2.0.0.dylib",
          "frameworks/libgobject-2.0.0.dylib",
          "frameworks/libgraphite2.3.dylib",
          "frameworks/libharfbuzz.0.dylib",
          "frameworks/libhdf5.320.dylib",
          "frameworks/libhwy.1.dylib",
          "frameworks/libidn.12.dylib",
          "frameworks/libimagequant.0.4.dylib",
          "frameworks/libintl.8.dylib",
          "frameworks/libjbig2dec.0.dylib",
          "frameworks/libjpeg.62.dylib",
          "frameworks/libjpeg.8.dylib",
          "frameworks/libleptonica.6.dylib",
          "frameworks/liblcms2.2.dylib",
          "frameworks/liblz4.1.dylib",
          "frameworks/liblzma.5.dylib",
          "frameworks/libmatio.14.dylib",
          "frameworks/libomp.dylib",
          "frameworks/libopenjp2.7.dylib",
          "frameworks/libopenjph.0.32.dylib",
          "frameworks/libpango-1.0.0.dylib",
          "frameworks/libpangocairo-1.0.0.dylib",
          "frameworks/libpangoft2-1.0.0.dylib",
          "frameworks/libpcre2-8.0.dylib",
          "frameworks/libpixman-1.0.dylib",
          "frameworks/libpng16.16.dylib",
          "frameworks/libqpdf.30.dylib",
          "frameworks/libraw_r.25.dylib",
          "frameworks/librsvg-2.2.dylib",
          "frameworks/libsharpyuv.0.dylib",
          "frameworks/libsz.2.dylib",
          "frameworks/libtesseract.5.dylib",
          "frameworks/libthai.0.dylib",
          "frameworks/libtiff.6.dylib",
          "frameworks/libuhdr.2.dylib",
          "frameworks/libvips.42.dylib",
          "frameworks/libwebp.7.dylib",
          "frameworks/libwebpdemux.2.dylib",
          "frameworks/libwebpmux.3.dylib",
          "frameworks/libxcb-render.0.dylib",
          "frameworks/libxcb-shm.0.dylib",
          "frameworks/libxcb.1.dylib",
          "frameworks/libzstd.1.dylib"
        ]
      },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
